node_modules/
.venv/
.DS_Store
.playwright-mcp/

# Real audio clips stay out of the repo (copyright).
# Only generated demo clips are tracked.
audio/*
!audio/demo/

# Real host photos stay out of the repo too (copyright / privacy).
# Only generated demo images are tracked.
images/*
!images/demo/

# Working question drafts stay local (real content, not demo material).
question-drafts/*
!question-drafts/.gitkeep
